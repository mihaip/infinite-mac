{
    "compilerOptions": {
        "target": "ES2020",
        "module": "esnext",
        "lib": ["ESNext", "DOM", "DOM.Iterable", "WebWorker"],
        "jsx": "react-jsx",
        "types": ["@cloudflare/workers-types/latest", "vite/client", "node"],
        "strict": true,
        "moduleResolution": "bundler",
        "esModuleInterop": true,
        "incremental": true,
        // Ignore warnings about the Worker and SharedWorker types referenced
        // in vite/client.
        "skipLibCheck": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["../src/*"]
        }
    },
    "include": ["**/*.ts", "../src/vite-env.d.ts"]
}
