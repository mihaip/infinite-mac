{
    "name": "infinite-mac",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "engines": {
        "node": ">=26.0.0"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.131.0",
        "classnames": "^2.3.2",
        "cookie": "^0.7.2",
        "file-saver": "^2.0.5",
        "jszip": "^3.7.0",
        "linkify-react": "^4.3.2",
        "openai": "^7.27.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "ringbuf.js": "^0.3.3",
        "typescript": "^5.8.3",
        "use-debounce": "^10.0.3"
    },
    "devDependencies": {
        "@cloudflare/vite-plugin": "^1.58.0",
        "@cloudflare/workers-types": "^5.20260727.1",
        "@types/audioworklet": "^0.0.77",
        "@types/cookie": "^0.6.0",
        "@types/dom-view-transitions": "^1.0.6",
        "@types/emscripten": "^1.39.13",
        "@types/file-saver": "^2.0.5",
        "@types/node": "^26.6.5",
        "@types/react": "^18.2.6",
        "@types/react-dom": "^18.2.4",
        "@vitejs/plugin-basic-ssl": "^2.3.0",
        "@vitejs/plugin-react": "^6.0.4",
        "clang-format": "^1.8.0",
        "csstype": "^3.1.3",
        "vite": "npm:@voidzero-dev/vite-plus-core@1.2.0",
        "vite-plugin-svgr": "^5.2.0",
        "vite-plus": "1.2.0",
        "wrangler": "^4.137.0"
    },
    "scripts": {
        "import-emulator": "scripts/import-emulator.sh",
        "import-disks": "uv run scripts/import-disks.py",
        "import-cd-roms": "uv run scripts/import-cd-roms.py",
        "import-library": "uv run scripts/import-library.py",
        "load-placeholder-files": "uv run scripts/load-placeholder-files.py",
        "build-tools": "scripts/build-tools.sh",
        "generate-local-ca-bundle": "node scripts/generate-local-ca-bundle.mjs",
        "start": "scripts/start-dev.sh",
        "build": "vp build",
        "preview": "vp preview --host",
        "worker-dev": "wrangler dev --port=3128",
        "worker-deploy": "scripts/worker-deploy.sh",
        "sync-disks": "scripts/sync-disks.sh",
        "format": "vp fmt --check src worker",
        "format:fix": "vp fmt src worker",
        "lint": "vp lint src worker",
        "lint:fix": "vp lint --fix src worker",
        "check": "npm run --silent typecheck && vp check src worker",
        "typecheck": "tsc --noEmit && tsc --noEmit --project worker/tsconfig.json",
        "format-macemu": "clang-format -i --glob=macemu/BasiliskII/src/Unix/JS/*"
    },
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "allowScripts": {
        "esbuild": true,
        "fsevents": true,
        "workerd": true
    },
    "overrides": {
        "vite": "$vite"
    }
}
